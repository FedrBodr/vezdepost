# Prod image for the Vezdepost VPS (docker-compose.override.yaml). Same image
# as upstream Dockerfile.dev, but dependencies are installed in their own layer
# from the manifests only (WOK-655): Dockerfile.dev copies the whole tree before
# `pnpm install`, so every code commit reinstalled and re-exported a ~4 GB
# node_modules layer — ~20 of the ~31 build minutes on this disk. Kept as a
# separate file so upstream syncs of Dockerfile.dev never conflict.
FROM node:22.20-bookworm-slim@sha256:b21fe589dfbe5cc39365d0544b9be3f1f33f55f3c86c87a76ff65a02f8f5848e
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
ARG NEXT_PUBLIC_GTM_ID
ENV NEXT_PUBLIC_GTM_ID=$NEXT_PUBLIC_GTM_ID
# procps: pm2 kills a process tree via `ps --ppid`; without it pm2 kills only
# the pnpm wrapper and the orphaned node keeps the port (EADDRINUSE)
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
    bash \
    nginx \
    ffmpeg \
    procps \
&& rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx


RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app

# dependency layer: changes only with a manifest, the lockfile, the prisma
# schema (root postinstall runs `prisma generate`) or the frontend postinstall
# script (fetch-gtm.mjs)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc /app/
COPY apps/frontend/scripts /app/apps/frontend/scripts/
COPY apps/backend/package.json /app/apps/backend/
COPY apps/commands/package.json /app/apps/commands/
COPY apps/extension/package.json /app/apps/extension/
COPY apps/frontend/package.json /app/apps/frontend/
COPY apps/orchestrator/package.json /app/apps/orchestrator/
COPY apps/sdk/package.json /app/apps/sdk/
COPY libraries/nestjs-libraries/src/database/prisma/schema.prisma /app/libraries/nestjs-libraries/src/database/prisma/
RUN pnpm install

COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

# the install layer is cached across builds, so refresh the self-hosted GTM
# script here as Dockerfile.dev's per-build install did
RUN pnpm --filter ./apps/frontend run fetch-gtm
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

CMD ["sh", "-c", "nginx && pnpm run pm2"]
