# Access log with Referer/User-Agent for user attribution and incident
# forensics. Caddy redacts Cookie/Authorization headers by default.
# Kept 30 days in the caddy-data volume: /data/access-logs/ in the container.
(access_log) {
	log {
		output file /data/access-logs/access.log {
			roll_size 50MiB
			roll_keep 20
			roll_keep_for 720h
		}
		format json
	}
}

# Baseline security headers. The CSP here is intentionally ONLY
# frame-ancestors (clickjacking defence for OAuth/approve screens); it does
# not restrict script/style/connect sources, so it cannot break app loading.
# Caddy serves valid TLS for every host below, so HSTS is safe.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "frame-ancestors 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

vezdepost.ru, www.vezdepost.ru {
	import access_log
	import security_headers
	# short links /go/<code> (deploy/links, mounted as a directory)
	import /etc/caddy/links/*.caddy
	# Revalidate on every visit (a cheap 304 via ETag) so a deploy shows up
	# without a hard refresh; with no Cache-Control browsers guess a lifetime
	header Cache-Control "no-cache"
	root * /srv/landing
	file_server
	encode gzip
}

app.vezdepost.ru {
	import access_log
	import security_headers
	reverse_proxy postiz:5000
	encode gzip
}

import /etc/caddy/sites/*.caddy
